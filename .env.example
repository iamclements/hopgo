# Hopgo control-plane configuration
# Copy to .env and fill in. NEVER commit .env (it holds a live Cloudflare token).

# Scoped Cloudflare API Token.
# Scope it to ONE account with: Workers Scripts:Edit + Workers KV Storage:Edit.
# Never use the Global API Key.
CF_API_TOKEN=

# Cloudflare account that owns the zone, KV namespace, and Worker.
CF_ACCOUNT_ID=

# KV namespace id that stores slug -> link records (e.g. the "hopgo-links" namespace).
CF_KV_NAMESPACE_ID=

# Tenant id stamped onto every link. Single-tenant homelab build: leave as "local".
HOPGO_TENANT_ID=local

# Public origin where the worker serves redirects. The portal builds copyable
# short links from this. Default https://hopgo.co.
HOPGO_PUBLIC_BASE_URL=https://hopgo.co

# Control-plane bind address. Default to LAN-only; do not expose to the internet directly.
# Use a Cloudflare Tunnel + Access for remote admin instead of opening a port.
HOST=127.0.0.1
PORT=8787
